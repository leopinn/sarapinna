# Copia questo file in .env e inserisci le tue chiavi.
# Le variabili PUBLIC_ sono visibili nel browser: EmailJS è pensato per funzionare così.

PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# Solo se usi l'endpoint server src/pages/api/contatti.js (output: 'server')
EMAILJS_PRIVATE_KEY=
MAIL_TO=pinna_sara@icloud.com
