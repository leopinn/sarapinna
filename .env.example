# --- SMTP Hostinger (casella info@sarapinna.it) ------------------------------
# Host e porta standard Hostinger. 465 = SSL/TLS implicito (consigliato),
# 587 = STARTTLS se il 465 fosse bloccato dall'hosting.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@tuodominio.it
# Password della casella creata su Hostinger (NON quella dell'account hPanel).
SMTP_PASS=la-password-della-casella

# Mittente delle mail: deve coincidere con SMTP_USER, altrimenti Hostinger rifiuta.
MAIL_FROM=info@tuodominio.it
MAIL_FROM_NOME=Sito sarapinna.it
# Dove arrivano i messaggi del form.
MAIL_TO=info@tuodominio.it

