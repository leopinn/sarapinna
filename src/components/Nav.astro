---
import { site } from '../data/site.js';
import Logo from './Logo.astro';
import { linguaDa, gemella, testi } from '../i18n/index.js';

interface Props { trasparente?: boolean }
const { trasparente = false } = Astro.props;

const path = Astro.url.pathname;
const lingua = linguaDa(path);
const t = testi[lingua];
const altraPagina = gemella(path);

// La home è la prima voce: nel menù si parte dalla seconda, il marchio fa da link
const attiva = (href: string) => path.replace(/\/+$/, '') === href.replace(/\/+$/, '');
---

<nav class:list={['nav', { 'nav--over': trasparente }]} data-trasparente={trasparente ? 'true' : 'false'}>
  <div class="nav__inner container">
    <a class="nav__mark" href={t.nav[0].href} aria-label={site.nome}><Logo /></a>
    <div class="nav__links" id="nav-links">
      {t.nav.slice(1).map((v) => (
        <a href={v.href} class:list={['nav__link', { 'is-active': attiva(v.href) }]}>{v.label}</a>
      ))}
    </div>
    <div class="nav__azioni">
      <a class="nav__lingua" href={altraPagina} title={t.cambioLingua} aria-label={t.cambioLingua}>
        <img src={t.bandiera} alt={t.bandieraAlt} width="24" height="24" />
      </a>
      <a class="btn" href={t.nav[3].href}>{t.prenotaOra}</a>
      <button
        class="nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    background: var(--paper);
    border-bottom: 1px solid var(--hairline);
    transition: background 240ms ease, border-color 240ms ease;
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .nav__mark {
    display: block;
    height: 56px;
    color: var(--vino);
    text-decoration: none;
    transition: color 240ms ease;
  }
  .nav__mark :global(.logo) { height: 100%; }
  .nav__mark:hover { color: var(--vino-hover); text-decoration: none; }
  .nav__mark:focus-visible { outline: 2px solid var(--vino); outline-offset: 4px; }
  .nav__links { display: flex; align-items: center; gap: 6px; }
  .nav__link {
    position: relative;
    font-size: 13px;
    padding: 8px 14px;
    color: var(--ink);
    text-decoration: none;
    transition: color 240ms ease;
  }
  /* la barra parte da sinistra e cresce: il colore del testo non cambia mai */
  .nav__link::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 2px;
    height: 2px;
    background: var(--vino);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 360ms cubic-bezier(.22, 1, .36, 1);
  }
  .nav__link:hover, .nav__link:focus-visible { text-decoration: none; }
  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__link.is-active::after { transform: scaleX(1); }
  .nav__link:focus-visible { outline: none; }

  @media (prefers-reduced-motion: reduce) {
    .nav__link::after { transition: none; }
  }

  .nav__azioni { display: flex; align-items: center; gap: 16px; }
  .nav__lingua {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 2px;
    text-decoration: none;
    transition: transform 160ms cubic-bezier(.22,.9,.28,1.2), opacity 140ms ease;
  }
  .nav__lingua img { display: block; width: 24px; height: 24px; object-fit: contain; }
  .nav__lingua:hover { transform: scale(1.12); text-decoration: none; }
  .nav__lingua:focus-visible { outline: 2px solid var(--vino); outline-offset: 2px; }
  .nav__lingua:active { transform: scale(.94); }

  /* stato sopra l'hero: barra trasparente su video scuro */
  .nav--over:not(.is-scrolled) {
    background: transparent;
    border-bottom-color: rgba(255,255,255,.28);
  }
  .nav--over:not(.is-scrolled) .nav__mark { color: #fff; }
  .nav--over:not(.is-scrolled) .nav__mark:focus-visible { outline-color: #fff; }
  .nav--over:not(.is-scrolled) .nav__link { color: rgba(255,255,255,.72); }
  .nav--over:not(.is-scrolled) .nav__lingua:focus-visible { outline-color: #fff; }

  /* pulsante hamburger: visibile solo sotto i 760px */
  .nav__toggle {
    display: none;
    position: relative;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: none;
    color: var(--ink);
    cursor: pointer;
    transition: color 240ms ease;
  }
  .nav__toggle span {
    position: absolute;
    left: 9px;
    right: 9px;
    height: 2px;
    background: currentColor;
    transition: transform 280ms cubic-bezier(.22, 1, .36, 1), opacity 160ms ease;
  }
  .nav__toggle span:nth-child(1) { top: 12px; }
  .nav__toggle span:nth-child(2) { top: 19px; }
  .nav__toggle span:nth-child(3) { top: 26px; }
  .nav__toggle:focus-visible { outline: 2px solid var(--vino); outline-offset: 2px; }

  /* da tre barre a X quando il menù è aperto */
  .nav.is-open .nav__toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav.is-open .nav__toggle span:nth-child(2) { opacity: 0; }
  .nav.is-open .nav__toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav--over:not(.is-scrolled) .nav__toggle { color: #fff; }
  .nav--over:not(.is-scrolled) .nav__toggle:focus-visible { outline-color: #fff; }

  @media (max-width: 760px) {
    .nav__inner { padding-top: 14px; padding-bottom: 14px; }
    .nav__mark { height: 48px; }
    .nav__azioni { gap: 12px; }
    .nav__toggle { display: block; }

    /* pannello a tutta larghezza sotto la barra */
    .nav__links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      max-height: calc(100dvh - 80px);
      overflow-y: auto;
      background: var(--paper);
      border-bottom: 1px solid var(--hairline);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
    }
    /* la transizione c'è solo mentre si apre/chiude col pulsante, mai al ridimensionamento */
    .nav.is-anim .nav__links {
      transition:
        opacity 200ms ease,
        transform 280ms cubic-bezier(.22, 1, .36, 1),
        visibility 0s linear 280ms;
    }
    .nav.is-open .nav__links {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .nav.is-anim.is-open .nav__links { transition-delay: 0s; }
    .nav__link {
      font-size: 16px;
      padding: 18px 24px;
      border-top: 1px solid var(--hairline);
    }
    .nav__link:first-child { border-top: 0; }
    .nav__link::after { left: 24px; right: auto; width: 28px; bottom: 10px; }

    /* menù aperto sopra l'hero: la barra diventa piena e i colori tornano scuri */
    .nav--over.is-open:not(.is-scrolled) {
      background: var(--paper);
      border-bottom-color: var(--hairline);
    }
    .nav--over.is-open:not(.is-scrolled) .nav__mark { color: var(--vino); }
    .nav--over.is-open:not(.is-scrolled) .nav__mark:focus-visible,
    .nav--over.is-open:not(.is-scrolled) .nav__toggle:focus-visible,
    .nav--over.is-open:not(.is-scrolled) .nav__lingua:focus-visible { outline-color: var(--vino); }
    .nav--over.is-open:not(.is-scrolled) .nav__toggle { color: var(--ink); }
    .nav--over.is-open:not(.is-scrolled) .nav__link { color: var(--ink); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__toggle span,
    .nav__links { transition: none !important; }
  }
  /* telefoni stretti: il logo orizzontale e i due pulsanti devono stare su una riga */
  @media (max-width: 380px) {
    .nav__inner { gap: 16px; padding-top: 16px; padding-bottom: 16px; }
    .nav__mark { height: 44px; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.nav');
  if (nav && nav.dataset.trasparente === 'true') {
    const aggiorna = () => {
      nav.classList.toggle('is-scrolled', window.scrollY > window.innerHeight - 90);
    };
    window.addEventListener('scroll', aggiorna, { passive: true });
    aggiorna();
  }

  // menù hamburger (mobile)
  const toggle = nav?.querySelector<HTMLButtonElement>('.nav__toggle');
  const pannello = nav?.querySelector<HTMLElement>('.nav__links');
  if (nav && toggle && pannello) {
    let timer: number | undefined;
    const imposta = (aperto: boolean, anima = true) => {
      window.clearTimeout(timer);
      if (anima) {
        nav.classList.add('is-anim');
        timer = window.setTimeout(() => nav.classList.remove('is-anim'), 340);
      } else {
        nav.classList.remove('is-anim');
      }
      nav.classList.toggle('is-open', aperto);
      toggle.setAttribute('aria-expanded', String(aperto));
    };

    toggle.addEventListener('click', () => {
      imposta(!nav.classList.contains('is-open'));
    });

    // click su una voce o fuori dalla nav: chiude
    pannello.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) imposta(false);
    });
    document.addEventListener('click', (e) => {
      if (nav.classList.contains('is-open') && !nav.contains(e.target as Node)) imposta(false);
    });

    // Esc chiude e riporta il focus sul pulsante
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        imposta(false);
        toggle.focus();
      }
    });

    // tornando a desktop il menù si resetta
    window.matchMedia('(min-width: 761px)').addEventListener('change', (e) => {
      if (e.matches) imposta(false, false);
    });
  }
</script>