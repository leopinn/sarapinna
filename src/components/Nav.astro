---
import { site } from '../data/site.js';
import Logo from './Logo.astro';
import { linguaDa, gemella, testi } from '../i18n/index.js';

interface Props { trasparente?: boolean }
const { trasparente = false } = Astro.props;

const path = Astro.url.pathname;
const lingua = linguaDa(path);
const t = testi[lingua];
const altraPagina = gemella(path);

// La home è la prima voce: nel menù si parte dalla seconda, il marchio fa da link
const attiva = (href: string) => path.replace(/\/+$/, '') === href.replace(/\/+$/, '');
---

<nav class:list={['nav', { 'nav--over': trasparente }]} data-trasparente={trasparente ? 'true' : 'false'}>
  <div class="nav__inner container">
    <a class="nav__mark" href={t.nav[0].href} aria-label={site.nome}><Logo /></a>
    <div class="nav__links">
      {t.nav.slice(1).map((v) => (
        <a href={v.href} class:list={['nav__link', { 'is-active': attiva(v.href) }]}>{v.label}</a>
      ))}
    </div>
    <div class="nav__azioni">
      <a class="nav__lingua" href={altraPagina} title={t.cambioLingua} aria-label={t.cambioLingua}>
        <img src={t.bandiera} alt={t.bandieraAlt} width="24" height="24" />
      </a>
      <a class="btn" href={t.nav[4].href}>{t.prenotaOra}</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    background: var(--paper);
    border-bottom: 1px solid var(--hairline);
    transition: background 240ms ease, border-color 240ms ease;
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 18px;
    padding-bottom: 18px;
  }
  .nav__mark {
    display: block;
    height: 40px;
    color: var(--ink);
    text-decoration: none;
    transition: color 240ms ease;
  }
  .nav__mark :global(.logo) { height: 100%; }
  .nav__mark:hover { text-decoration: none; }
  .nav__mark:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }
  .nav__links { display: flex; align-items: center; gap: 6px; }
  .nav__link {
    position: relative;
    font-size: 13px;
    padding: 8px 14px;
    color: var(--ink);
    text-decoration: none;
    transition: color 240ms ease;
  }
  /* la barra parte da sinistra e cresce: il colore del testo non cambia mai */
  .nav__link::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 2px;
    height: 2px;
    background: var(--teal);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 360ms cubic-bezier(.22, 1, .36, 1);
  }
  .nav__link:hover, .nav__link:focus-visible { text-decoration: none; }
  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__link.is-active::after { transform: scaleX(1); }
  .nav__link:focus-visible { outline: none; }

  @media (prefers-reduced-motion: reduce) {
    .nav__link::after { transition: none; }
  }

  .nav__azioni { display: flex; align-items: center; gap: 16px; }
  .nav__lingua {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 2px;
    text-decoration: none;
    transition: transform 160ms cubic-bezier(.22,.9,.28,1.2), opacity 140ms ease;
  }
  .nav__lingua img { display: block; width: 24px; height: 24px; object-fit: contain; }
  .nav__lingua:hover { transform: scale(1.12); text-decoration: none; }
  .nav__lingua:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
  .nav__lingua:active { transform: scale(.94); }

  /* stato sopra l'hero: barra trasparente su video scuro */
  .nav--over:not(.is-scrolled) {
    background: transparent;
    border-bottom-color: rgba(255,255,255,.28);
  }
  .nav--over:not(.is-scrolled) .nav__mark { color: #fff; --sp-wine: #fff; }
  .nav--over:not(.is-scrolled) .nav__mark:focus-visible { outline-color: #fff; }
  .nav--over:not(.is-scrolled) .nav__link { color: rgba(255,255,255,.72); }
  .nav--over:not(.is-scrolled) .nav__lingua:focus-visible { outline-color: #fff; }

  @media (max-width: 760px) {
    .nav__links { display: none; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.nav');
  if (nav && nav.dataset.trasparente === 'true') {
    const aggiorna = () => {
      nav.classList.toggle('is-scrolled', window.scrollY > window.innerHeight - 90);
    };
    window.addEventListener('scroll', aggiorna, { passive: true });
    aggiorna();
  }
</script>
