---
import { esperienze } from '../data/site.js';
import { fotoEsperienza } from '../data/fotoEsperienze.js';
import { linguaDa, testi } from '../i18n/index.js';

const lingua = linguaDa(Astro.url.pathname);
const t = testi[lingua];
const e = t.esperienze;
const elenco = esperienze.map((x) => {
  const foto = fotoEsperienza(x.numero);
  return { ...x, ...x[lingua], foto: foto.length ? foto : [x.immagine] };
});
---

<!-- fondo chiaro: i Contatti subito sotto sono già champagne -->
<section class="section" id="elenco-esperienze">
  <div class="container container--largo">
    <div class="schede">
      {elenco.map((x) => (
        <article class="scheda" id={x.id} data-reveal>
          <figure class="scheda__foto" data-galleria>
            <div class="scheda__pista" data-pista>
              {x.foto.map((src, i) => (
                <div class="scheda__slide" aria-hidden={i === 0 ? undefined : 'true'}>
                  <img src={src} alt={x.foto.length > 1 ? `${x.titolo} (${i + 1}/${x.foto.length})` : x.titolo} loading="lazy" draggable="false" />
                </div>
              ))}
            </div>
            {x.foto.length > 1 && (
              <>
                <button type="button" class="freccia freccia--prec" data-prec aria-label={e.fotoPrecedente}>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
                </button>
                <button type="button" class="freccia freccia--succ" data-succ aria-label={e.fotoSuccessiva}>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
                </button>
              </>
            )}
          </figure>
          <div class="scheda__corpo">
            <p class="scheda__numero">{x.numero}</p>
            <h2 class="scheda__titolo">{x.titolo}</h2>
            <p class="scheda__testo">{x.testo}</p>
            <ul class="scheda__meta">
              {x.meta.map((m) => <li>{m}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <!-- esperienza su misura: per chi cerca qualcosa che non è in elenco -->
    <div class="desiderio">
      <h2 data-reveal>{e.desiderio.titolo}</h2>
      <span class="desiderio__filetto" aria-hidden="true"></span>
      <p class="desiderio__testo" data-reveal>{e.desiderio.testo}</p>
      <div data-reveal>
        <a class="btn desiderio__cta" href="#form-contatti">{e.desiderio.cta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* tutte le schede uguali, nessuna in evidenza */
  .schede {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 72px 48px;
  }
  /* se l'ultima resta sola sulla riga, la centro con la stessa larghezza */
  .scheda:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    justify-self: center;
    width: calc((100% - 48px) / 2);
  }

  .scheda { scroll-margin-top: 120px; }
  .scheda__foto {
    position: relative;
    margin: 0 0 24px;
    aspect-ratio: 4 / 3;
    border-radius: 4px;
    overflow: hidden;
    background: var(--hairline); /* segnaposto finché la foto non c'è */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .scheda__pista {
    position: absolute;
    inset: 0;
    display: flex;
    transition: transform 500ms cubic-bezier(.22, 1, .36, 1);
  }
  .scheda__slide { flex: 0 0 100%; height: 100%; }
  .scheda__foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    color: transparent;
  }
  .freccia {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgba(var(--scrim), .35);
    border-radius: 50%;
    background: rgba(var(--scrim), .45);
    color: var(--paper);
    cursor: pointer;
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity 200ms ease, background 200ms ease;
  }
  .freccia--prec { left: 16px; }
  .freccia--succ { right: 16px; }
  .freccia:hover { background: rgba(var(--scrim), .7); }
  .freccia:focus-visible { outline: 2px solid var(--vino); outline-offset: 2px; }
  .freccia:disabled { cursor: default; }
  .scheda__foto:hover .freccia,
  .scheda__foto:has(:focus-visible) .freccia { opacity: 1; }
  .scheda__foto:hover .freccia:disabled,
  .scheda__foto:has(:focus-visible) .freccia:disabled { opacity: .3; }
  @media (hover: none) {
    .freccia { opacity: 1; }
    .freccia:disabled { opacity: .3; }
  }
  .scheda__numero { font-size: 13px; letter-spacing: .09em; color: var(--champagne); }
  .scheda__titolo { font-size: 30px; line-height: 1.05; letter-spacing: 1.5px; margin-top: 8px; }
  .scheda__testo { margin-top: 16px; line-height: 1.7; max-width: 34em; }

  .scheda__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .scheda__meta li {
    font-size: 13px;
    color: var(--fog);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 6px 14px;
  }

  /* il filetto in alto separa il blocco dalle schede */
  .desiderio {
    margin-top: 96px;
    padding-top: 96px;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .desiderio__filetto {
    display: block;
    width: 48px;
    height: 1px;
    margin: 32px auto;
    background: var(--vino);
    opacity: .5;
  }
  .desiderio__testo { max-width: 36em; line-height: 1.7; }
  .desiderio__cta { margin-top: 40px; }
  .desiderio__cta:focus-visible { outline: 2px solid var(--vino); outline-offset: 3px; }

  @media (max-width: 900px) {
    .schede { grid-template-columns: 1fr; gap: 48px; }
    .scheda:last-child:nth-child(odd) { width: auto; justify-self: stretch; }
    /* su mobile resta orizzontale, appena più bassa di prima (era 3/2) */
    .scheda__foto { aspect-ratio: 16 / 10; }
    .freccia { width: 36px; height: 36px; opacity: 1; }
    .freccia:disabled { opacity: .3; }
    .freccia--prec { left: 12px; }
    .freccia--succ { right: 12px; }
    .desiderio { margin-top: 64px; padding-top: 64px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scheda__pista,
    .freccia { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-galleria]').forEach((galleria) => {
    const pista = galleria.querySelector<HTMLElement>('[data-pista]');
    const prec = galleria.querySelector<HTMLButtonElement>('[data-prec]');
    const succ = galleria.querySelector<HTMLButtonElement>('[data-succ]');
    if (!pista) return;

    const totale = pista.children.length;
    if (totale < 2) return;

    let indice = 0;
    let inizioX = 0;
    let spostamento = 0;
    let premuto = false;
    let trascinato = false;

    const vai = (n: number) => {
      indice = Math.max(0, Math.min(totale - 1, n));
      pista.style.transform = `translateX(${-indice * 100}%)`;
      Array.from(pista.children).forEach((slide, i) => {
        slide.setAttribute('aria-hidden', String(i !== indice));
      });
      if (prec) prec.disabled = indice === 0;
      if (succ) succ.disabled = indice === totale - 1;
    };
    vai(0);

    prec?.addEventListener('click', () => vai(indice - 1));
    succ?.addEventListener('click', () => vai(indice + 1));

    galleria.addEventListener('pointerdown', (event) => {
      if ((event.target as HTMLElement).closest('button') || event.button > 0) return;
      premuto = true;
      trascinato = false;
      inizioX = event.clientX;
      spostamento = 0;
    });
    galleria.addEventListener('pointermove', (event) => {
      if (!premuto) return;
      spostamento = event.clientX - inizioX;
      if (!trascinato && Math.abs(spostamento) > 6) {
        trascinato = true;
        galleria.setPointerCapture(event.pointerId);
        pista.style.transition = 'none';
      }
      if (trascinato) pista.style.transform = `translateX(calc(${-indice * 100}% + ${spostamento}px))`;
    });

    const rilascia = () => {
      if (!premuto) return;
      premuto = false;
      if (!trascinato) return;
      pista.style.transition = '';
      const soglia = Math.min(80, galleria.clientWidth * 0.15);
      if (spostamento < -soglia) vai(indice + 1);
      else if (spostamento > soglia) vai(indice - 1);
      else vai(indice);
    };
    galleria.addEventListener('pointerup', rilascia);
    galleria.addEventListener('pointercancel', rilascia);
  });
</script>
