---
import { linguaDa, testi } from '../i18n/index.js';

const t = testi[linguaDa(Astro.url.pathname)].about;
---

<!-- 1: foto a tutto schermo, come l'hero della Home, con nome e ruolo in basso -->
<section class="about-hero">
  <img class="about-hero__foto" src="/images/foto-sara.jpeg" alt={t.fotoAlt} fetchpriority="high" />
  <div class="about-hero__scrim"></div>
  <div class="about-hero__testo container">
    <h1 data-reveal-hero>{t.nome}</h1>
    <p class="about-hero__ruolo" data-reveal-hero>{t.ruolo}</p>
  </div>
</section>

<section class="about" id="about">
  <!-- 2: chi sono -->
  <div class="presentazione container">
    <h2 data-reveal>{t.titolo}</h2>
    <div class="presentazione__testo" data-reveal>
      {t.paragrafi.map((p) => <p>{p}</p>)}
    </div>
  </div>

  <!-- 3: riquadro a contrasto con il metodo -->
  <div class="container">
    <div class="metodo" data-reveal>
      <h2 class="metodo__titolo">{t.metodo.titolo}</h2>
      <ul class="metodo__voci">
        {t.metodo.voci.map((v) => (
          <li>
            <h3>{v.titolo}</h3>
            <p>{v.testo}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- 4: perché scegliermi -->
  <div class="perche container">
    <h2 class="perche__titolo" data-reveal>{t.perche.titolo}</h2>
    <span class="perche__filetto" aria-hidden="true"></span>
    <ul class="perche__voci">
      <li data-reveal>
        <!-- esperienze ideate: lampadina -->
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <path d="M24 5a13 13 0 0 0-7.5 23.6V33a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-4.4A13 13 0 0 0 24 5z" />
          <path d="M20 39h8M21.5 43h5" />
          <path d="M24 35V24m0 0-4-4m4 4 4-4" />
        </svg>
        <p>{t.perche.voci[0]}</p>
      </li>
      <li data-reveal>
        <!-- partner locali: due persone -->
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <circle cx="18" cy="16" r="6.5" />
          <path d="M5 42c0-7.2 5.8-12 13-12s13 4.8 13 12" />
          <circle cx="34" cy="19" r="5" />
          <path d="M33 30c5.8.3 10 4.4 10 11" />
        </svg>
        <p>{t.perche.voci[1]}</p>
      </li>
      <li data-reveal>
        <!-- fuori dai soliti percorsi: mappa con sentiero e cuore -->
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <path d="M5 12l12-5 14 5 12-5v29l-12 5-14-5-12 5z" />
          <path d="M17 7v29M31 12v29" />
          <path d="M9 32c4-1 6-5 10-6s7 2 10-2" stroke-dasharray="2.5 3" />
          <path d="M37.5 24.5s-4.5-2.8-4.5-5.6a2.3 2.3 0 0 1 4.5-.8 2.3 2.3 0 0 1 4.5.8c0 2.8-4.5 5.6-4.5 5.6z" />
        </svg>
        <p>{t.perche.voci[2]}</p>
      </li>
    </ul>
  </div>

  <!-- 5: contatto; il form sta nella sezione Contatti subito sotto -->
  <div class="chiusura container" data-reveal>
    <a class="btn chiusura__cta" href="#form-contatti">{t.cta} <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  /* ───── Foto a tutto schermo ───── */
  .about-hero { position: relative; height: 100vh; min-height: 620px; background: var(--ink); overflow: hidden; }
  .about-hero__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Sara è sulla sinistra della foto: la tengo in quadro anche nei tagli stretti */
    object-position: 25% 40%;
    transform: scale(1.04);
  }
  .about-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(var(--scrim), .45) 0%, rgba(var(--scrim), .05) 40%, rgba(var(--scrim), .78) 100%);
  }
  .about-hero__testo {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 64px;
    text-align: center;
  }
  .about-hero h1 {
    color: #fff;
    font-size: clamp(72px, 13vw, 190px);
    line-height: .85;
    letter-spacing: .02em;
  }
  .about-hero__ruolo {
    margin-top: 16px;
    font-size: 15px;
    letter-spacing: .32em;
    text-transform: uppercase;
    color: rgba(255,255,255,.82);
  }

  /* ───── Chi sono ───── */
  .about { padding: 128px 0 96px; }
  .presentazione {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 64px;
    align-items: start;
  }
  .presentazione h2 { font-size: 56px; letter-spacing: 2.5px; max-width: 8em; }
  .presentazione__testo p { line-height: 1.7; font-size: 18px; }
  .presentazione__testo p + p { margin-top: 20px; }

  /* ───── Riquadro metodo (a contrasto) ───── */
  .metodo {
    margin-top: 128px;
    padding: 72px 64px;
    background: var(--mist);
    border-radius: 4px;
    text-align: center;
  }
  .metodo__titolo {
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: .18em;
  }
  .metodo__voci {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    list-style: none;
    margin: 48px auto 0;
    padding: 0;
    max-width: 960px;
  }
  .metodo__voci h3 { font-size: 26px; color: var(--vino); }
  .metodo__voci p { margin-top: 12px; line-height: 1.7; }

  /* ───── Perché scegliermi ───── */
  .perche { padding-top: 128px; text-align: center; }
  .perche__filetto {
    display: block;
    width: 48px;
    height: 1px;
    margin: 32px auto 48px;
    background: var(--vino);
    opacity: .5;
  }
  .perche__voci {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 900px;
  }
  .perche__voci svg {
    width: 56px;
    height: 56px;
    fill: none;
    stroke: var(--vino);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .perche__voci p {
    max-width: 14em;
    margin: 20px auto 0;
    font-size: 18px;
    line-height: 1.4;
  }

  /* ───── Bottone finale ───── */
  .chiusura { margin-top: 96px; text-align: center; }
  .chiusura__cta { text-transform: uppercase; letter-spacing: .09em; }
  .chiusura__cta span { display: inline-block; margin-left: 6px; transition: transform 300ms cubic-bezier(.22, 1, .36, 1); }
  .chiusura__cta:hover span { transform: translateX(4px); }
  .chiusura__cta:focus-visible { outline: 2px solid var(--vino); outline-offset: 3px; }

  @media (max-width: 900px) {
    .about-hero__testo { bottom: 48px; }
    .about-hero__ruolo { font-size: 13px; letter-spacing: .24em; }

    .about { padding: 80px 0 64px; }
    .presentazione { grid-template-columns: 1fr; gap: 32px; }
    .presentazione h2 { font-size: 40px; letter-spacing: 2px; }
    .presentazione__testo p { font-size: 16px; }

    .metodo { margin-top: 80px; padding: 48px 24px; }
    .metodo__titolo { font-size: 26px; letter-spacing: .12em; }
    .metodo__voci { grid-template-columns: 1fr; gap: 32px; margin-top: 32px; }
    .metodo__voci h3 { font-size: 24px; }

    .perche { padding-top: 80px; }
    .perche__voci { grid-template-columns: 1fr; gap: 40px; }
    .chiusura { margin-top: 64px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chiusura__cta span { transition: none; }
  }
</style>
