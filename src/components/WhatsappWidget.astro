---
import { site } from '../data/site.js';
import { linguaDa, testi } from '../i18n/index.js';

const t = testi[linguaDa(Astro.url.pathname)];
const href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t.whatsapp.messaggio)}`;
---

<a class="wa" href={href} target="_blank" rel="noopener" aria-label={t.whatsapp.etichetta}>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.002-5.45 4.437-9.884 9.889-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.886 9.884M20.463 3.488A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413" />
  </svg>
</a>

<style>
  .wa {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 80;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 12px 28px -10px rgba(37, 211, 102, .7);
    transition: background 140ms ease, transform 160ms cubic-bezier(.22,.9,.28,1.2);
  }
  .wa svg { width: 30px; height: 30px; position: relative; z-index: 1; }
  .wa:hover { background: #1fb457; color: #fff; text-decoration: none; transform: scale(1.06); }
  .wa:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .wa:active { transform: scale(.97); }

  /* anelli di pulsazione */
  .wa::before,
  .wa::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25d366;
    animation: wa-pulse 2.4s cubic-bezier(.24,.7,.34,1) infinite;
  }
  .wa::after { animation-delay: 1.2s; }
  .wa:hover::before,
  .wa:hover::after { animation-play-state: paused; }

  @keyframes wa-pulse {
    0%   { transform: scale(1); opacity: .55; }
    70%  { transform: scale(1.75); opacity: 0; }
    100% { transform: scale(1.75); opacity: 0; }
  }

  @media (max-width: 600px) {
    .wa { right: 16px; bottom: 16px; width: 52px; height: 52px; }
    .wa svg { width: 28px; height: 28px; }
  }
</style>
