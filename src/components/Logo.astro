---
// Il logo è inserito inline: usa currentColor, quindi segue il colore del testo
// del contenitore (bordeaux sui fondi chiari, bianco sul video, avorio nel footer).
import orizzontale from '../../public/images/logo-orizzontale.svg?raw';
import verticale from '../../public/images/logo-verticale.svg?raw';
import monogramma from '../../public/images/monogramma.svg?raw';

interface Props {
  variante?: 'orizzontale' | 'verticale' | 'monogramma';
  class?: string;
}
const { variante = 'orizzontale', class: classe } = Astro.props;

const sorgenti = { orizzontale, verticale, monogramma };
const svg = sorgenti[variante]
  .replace(/<title>[\s\S]*?<\/title>/, '')
  .replace(/\s*role="img"\s*aria-label="[^"]*"/, ' aria-hidden="true" focusable="false"');
---

<span class:list={['logo', `logo--${variante}`, classe]} set:html={svg} />

<style>
  .logo { display: inline-block; line-height: 0; }
  .logo :global(svg) { display: block; height: 100%; width: auto; }
</style>
