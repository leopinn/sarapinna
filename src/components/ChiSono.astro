---
interface Props { compatto?: boolean }
const { compatto = false } = Astro.props;
---

<section class="section" id="chi-sono">
  <div class="container split">
    <div data-reveal>
      <p class="eyebrow">Chi sono</p>
      <h2>Ospitalità fatta a mano, una casa alla volta</h2>
      <p class="lead">Ho 28 anni e accolgo ospiti tra Isola della Scala e Verona.</p>
      <p class="testo">
        Ho iniziato con un appartamento e la voglia di far sentire le persone a casa anche lontano
        da casa. Oggi gestisco i miei alloggi su Airbnb e Booking e curo tutto io: la pulizia, il
        check-in, i messaggi a cui rispondo anche la sera tardi.
      </p>
      <p class="testo">
        Chi arriva trova le chiavi, un frigo con qualcosa dentro e una mappa dei posti dove mangio
        io — non quelli delle guide. Se hai bisogno di una culla, di un parcheggio o di un consiglio
        sull'Arena, basta scrivermi.
      </p>
      {!compatto && (
        <div class="numeri">
          <div><p class="numeri__n">2</p><p class="numeri__l">Appartamenti gestiti</p></div>
          <div><p class="numeri__n">15′</p><p class="numeri__l">Dal centro di Verona</p></div>
          <div><p class="numeri__n">1</p><p class="numeri__l">Persona che risponde: io</p></div>
        </div>
      )}
    </div>
    <figure class="ritratto" data-reveal>
      <img src="/images/sara.jpg" alt="Sara Pinna" loading="lazy" />
      <figcaption>Sara Pinna, Isola della Scala (VR)</figcaption>
    </figure>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 64px;
    align-items: center;
  }
  .lead { font-weight: 500; font-size: 20px; line-height: 1.5; margin: 24px 0; }
  h2 { margin-top: 24px; }
  .testo { max-width: 36em; margin-bottom: 16px; }
  .numeri { display: flex; flex-wrap: wrap; border-top: 1px solid var(--hairline); margin-top: 32px; }
  .numeri > div { flex: 1 1 140px; padding: 24px 24px 0 0; min-width: 0; }
  .numeri__n { font-family: var(--font-display); font-weight: 400; font-size: 56px; line-height: 1; letter-spacing: 2.25px; }
  .numeri__l { font-size: 13px; color: var(--fog); margin-top: 8px; }
  .ritratto { margin: 0; min-width: 0; }
  .ritratto img { display: block; width: 100%; height: 600px; object-fit: cover; background: var(--mist); }
  .ritratto figcaption { font-size: 13px; color: var(--fog); margin-top: 16px; }
  @media (max-width: 900px) { .ritratto img { height: 420px; } }
</style>
