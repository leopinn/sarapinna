---
import { site } from '../data/site.js';
import FormContatti from './FormContatti.astro';
import { linguaDa, testi } from '../i18n/index.js';

const t = testi[linguaDa(Astro.url.pathname)].contatti;
---

<section class="section section--soft" id="contatti">
  <div class="container split">
    <div data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.titolo}</h2>
      <p class="testo">{t.testo}</p>

      <div class="blocchi">
        <div class="blocco">
          <p class="eyebrow">{t.doveSono}</p>
          <p class="blocco__v">{site.citta}</p>
          <p class="blocco__n">{t.distanza}</p>
        </div>
        <div class="blocco">
          <p class="eyebrow">{t.telefono}</p>
          <p class="blocco__v"><a href={`tel:${site.telefonoRaw}`}>{site.telefono}</a></p>
        </div>
        <div class="blocco">
          <p class="eyebrow">{t.email}</p>
          <p class="blocco__v"><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      </div>
    </div>

    <FormContatti />
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 64px;
    align-items: start;
  }
  h2 { margin: 24px 0; }
  .testo { max-width: 32em; margin-bottom: 48px; }
  .blocchi { display: flex; flex-direction: column; gap: 32px; }
  .blocco { border-top: 1px solid var(--hairline); padding-top: 24px; }
  .blocco__v {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.05;
    letter-spacing: 1.5px;
    margin-top: 8px;
  }
  .blocco__v a { color: var(--ink); }
  .blocco__v a:hover { color: var(--teal); }
  .blocco__n { font-size: 16px; color: var(--fog); margin-top: 8px; }
</style>
