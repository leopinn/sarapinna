---
import { linguaDa, testi } from '../i18n/index.js';

const lingua = linguaDa(Astro.url.pathname);
const t = testi[lingua].form;
---

<form
  class="form"
  id="form-contatti"
  data-reveal
  data-lingua={lingua}
  data-invio={t.invio}
  data-invia={t.invia}
  data-inviato={t.inviato}
  data-grazie={t.grazie}
  data-errore={t.erroreGenerico}
>
  <h3>{t.titolo}</h3>
  <p class="form__sub">{t.sottotitolo}</p>

  <div class="form__riga">
    <label class="field">
      <span>{t.nome} <span class="req">*</span></span>
      <input name="nome" type="text" placeholder={t.nome} required autocomplete="given-name" />
    </label>
    <label class="field">
      <span>{t.cognome} <span class="req">*</span></span>
      <input name="cognome" type="text" placeholder={t.cognome} required autocomplete="family-name" />
    </label>
  </div>

  <label class="field form__campo">
    <span>{t.email} <span class="req">*</span></span>
    <input name="email" type="email" placeholder={t.emailSegnaposto} required autocomplete="email" />
  </label>

  <label class="field form__campo">
    <span>{t.messaggio} <span class="req">*</span></span>
    <textarea name="messaggio" rows="5" placeholder={t.messaggioSegnaposto} required></textarea>
  </label>

  <div class="form__esca" aria-hidden="true">
    <label>
      {t.esca}
      <input name="sito" type="text" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="form__piede">
    <button class="btn" type="submit">{t.invia}</button>
    <span class="form__stato" role="status" aria-live="polite"></span>
  </div>
</form>

<style>
  .form { background: var(--paper); border: 1px solid var(--hairline); padding: 32px; min-width: 0; }
  .form__sub { font-size: 13px; color: var(--fog); margin: 8px 0 32px; }
  .form__riga { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: 16px; }
  .form__campo { margin-top: 16px; }
  .form__piede {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    border-top: 1px solid var(--hairline);
    margin-top: 24px;
    padding-top: 24px;
  }
  .form__stato { font-size: 13px; color: var(--fog); }
  .form__esca {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#form-contatti');
  if (form) {
    const bottone = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const stato = form.querySelector<HTMLElement>('.form__stato');

    // le etichette arrivano dal server già tradotte: lo script non conosce le lingue
    const d = form.dataset;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!bottone || !stato) return;
      const dati = Object.fromEntries(new FormData(form));
      dati.lingua = d.lingua ?? 'it';

      bottone.disabled = true;
      bottone.textContent = d.invio ?? '…';
      stato.textContent = '';

      try {
        const r = await fetch('/api/contatti.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(dati),
        });
        const esito = await r.json().catch(() => ({}) as { errore?: string });
        if (!r.ok) throw new Error(esito.errore || 'invio non riuscito');

        form.reset();
        bottone.textContent = d.inviato ?? '';
        stato.textContent = d.grazie ?? '';
      } catch (err) {
        bottone.disabled = false;
        bottone.textContent = d.invia ?? '';
        stato.textContent = (err instanceof Error && err.message) || d.errore || '';
        console.error(err);
      }
    });
  }
</script>
