---
import { site } from '../data/site.js';
import Logo from './Logo.astro';
import { linguaDa, testi } from '../i18n/index.js';

const lingua = linguaDa(Astro.url.pathname);
const t = testi[lingua];
const f = t.footer;
const anno = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__griglia">
      <div>
        <p class="footer__mark" role="img" aria-label={site.nome}><Logo /></p>
        <p class="footer__testo">{f.testo}</p>
        <div class="footer__social">
          <a class="footer__icona" href={site.instagram} target="_blank" rel="noopener" aria-label={f.instagram}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
            </svg>
          </a>
          {site.airbnb && (
            <a class="footer__icona" href={site.airbnb} target="_blank" rel="noopener" aria-label={f.airbnb}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M12 10c-2 0-3 1-3 3 0 1.5 1.494 3.535 3 5.5 1 1 1.5 1.5 2.5 2s2.5 1 4.5-.5 1.5-3.5.5-6-2.333-5.5-5-9.5c-.834-1-1.5-1.5-2.503-1.5-1 0-1.623.45-2.497 1.5-2.667 4-4 7-5 9.5s-1.5 4.5.5 6 3.5 1 4.5.5 1.5-1 2.5-2c1.506-1.965 3-4 3-5.5 0-2-1-3-3-3z" />
              </svg>
            </a>
          )}
        </div>
      </div>
      <div>
        <p class="footer__t">{f.colonnaSito}</p>
        <div class="footer__col">
          {t.nav.slice(0, 4).map((v) => <a href={v.href}>{v.label}</a>)}
        </div>
      </div>
      <div>
        <p class="footer__t">{f.colonnaPrenota}</p>
        <div class="footer__col">
          <a href={site.airbnb || t.nav[4].href}>Airbnb</a>
          <a href={t.nav[4].href}>{f.richiedi}</a>
        </div>
      </div>
      <div>
        <p class="footer__t">{f.colonnaContatti}</p>
        <div class="footer__col">
          <span>{site.indirizzo}</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={`tel:${site.telefonoRaw}`}>{site.telefono}</a>
        </div>
      </div>
    </div>
    <div class="footer__base">
      <span>©{anno} {site.nome} · {f.diritti}</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--ink); color: var(--paper); padding: 72px 0 32px; }
  .footer__griglia { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 48px; }
  .footer__mark { height: 48px; margin: 0 0 16px; color: var(--paper); --sp-wine: var(--paper); }
  .footer__mark :global(.logo) { height: 100%; }
  .footer__testo { color: rgba(255,255,255,.66); margin-bottom: 24px; max-width: 26em; }
  .footer__t { font-size: 13px; font-weight: 500; margin-bottom: 24px; }
  .footer__col { display: flex; flex-direction: column; gap: 16px; }
  .footer a, .footer__col span { font-size: 13px; color: rgba(255,255,255,.66); }
  .footer a:hover { color: #fff; }

  .footer__social { display: flex; gap: 8px; margin-left: -7px; }
  .footer__icona {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: rgba(255,255,255,.66);
    transition: color 140ms ease, background 140ms ease;
  }
  .footer__icona svg { width: 24px; height: 24px; display: block; }
  .footer__icona:hover { color: #fff; background: rgba(255,255,255,.1); }
  .footer__icona:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .footer__icona:active { background: rgba(255,255,255,.18); }
  .footer__base {
    border-top: 1px solid rgba(255,255,255,.28);
    margin-top: 64px;
    padding-top: 32px;
    display: flex;
    justify-content: center;
    font-size: 13px;
    color: rgba(255,255,255,.66);
  }
</style>
