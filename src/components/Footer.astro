---
import { site } from '../data/site.js';
const anno = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__griglia">
      <div>
        <p class="footer__mark">{site.nome}</p>
        <p class="footer__testo">
          Affitti brevi tra Isola della Scala e Verona. Case curate una per una, accoglienza di persona.
        </p>
        <a class="footer__ig" href={site.instagram} target="_blank" rel="noopener" aria-label="Profilo Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>
      <div>
        <p class="footer__t">Sito</p>
        <div class="footer__col">
          <a href="/">Home</a>
          <a href="/chi-sono">Chi sono</a>
          <a href="/servizi">Servizi</a>
          <a href="/galleria">Galleria</a>
        </div>
      </div>
      <div>
        <p class="footer__t">Prenota</p>
        <div class="footer__col">
          <a href={site.airbnb || '/contatti'}>Airbnb</a>
          <a href={site.booking || '/contatti'}>Booking</a>
          <a href="/contatti">Richiedi disponibilità</a>
        </div>
      </div>
      <div>
        <p class="footer__t">Contatti</p>
        <div class="footer__col">
          <span>{site.indirizzo}</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={`tel:${site.telefonoRaw}`}>{site.telefono}</a>
        </div>
      </div>
    </div>
    <div class="footer__base">
      <span>©{anno} {site.nome} · Tutti i diritti riservati</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--ink); color: var(--paper); padding: 72px 0 32px; }
  .footer__griglia { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 48px; }
  .footer__mark { font-family: var(--font-display); font-weight: 400; font-size: 30px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 16px; }
  .footer__testo { color: rgba(255,255,255,.66); margin-bottom: 24px; max-width: 26em; }
  .footer__t { font-size: 13px; font-weight: 500; margin-bottom: 24px; }
  .footer__col { display: flex; flex-direction: column; gap: 16px; }
  .footer a, .footer__col span { font-size: 13px; color: rgba(255,255,255,.66); }
  .footer a:hover { color: #fff; }

  .footer__ig {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    margin-left: -7px;
    border-radius: 50%;
    color: rgba(255,255,255,.66);
    transition: color 140ms ease, background 140ms ease;
  }
  .footer__ig svg { width: 24px; height: 24px; display: block; }
  .footer__ig:hover { color: #fff; background: rgba(255,255,255,.1); }
  .footer__ig:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .footer__ig:active { background: rgba(255,255,255,.18); }
  .footer__base {
    border-top: 1px solid rgba(255,255,255,.28);
    margin-top: 64px;
    padding-top: 32px;
    display: flex;
    justify-content: center;
    font-size: 13px;
    color: rgba(255,255,255,.66);
  }
</style>
