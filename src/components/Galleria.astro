---
import { galleria } from '../data/site.js';
---

<section class="section" id="galleria">
  <div class="container">
    <header class="intro" data-reveal>
      <div>
        <p class="eyebrow">Galleria</p>
        <h2>Le stanze, prima di arrivare</h2>
      </div>
      <p class="hint">Clicca una foto per vederla grande</p>
    </header>
    <div class="grid">
      {galleria.map((f, i) => (
        <button
          class:list={['tile', { 'tile--wide': f.wide }]}
          style={`transition-delay:${i * 80}ms`}
          data-src={f.src}
          data-alt={f.alt}
          data-reveal
          type="button"
          aria-label={`Apri: ${f.alt}`}
        >
          <img src={f.src} alt={f.alt} loading="lazy" />
        </button>
      ))}
    </div>
  </div>
</section>

<div class="lightbox" hidden>
  <img alt="" />
  <span class="lightbox__chiudi">Chiudi ✕</span>
</div>

<style>
  .intro { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 48px; }
  .intro > div { max-width: 32em; }
  .intro h2 { margin-top: 24px; }
  .hint { font-size: 13px; color: var(--fog); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .tile {
    padding: 0;
    border: none;
    background: var(--mist);
    height: 300px;
    cursor: zoom-in;
    overflow: hidden;
    transition: opacity 700ms ease, transform 700ms ease;
  }
  .tile--wide { grid-column: span 2; height: 420px; }
  .tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms ease; }
  .tile:hover img { transform: scale(1.03); }
  @media (max-width: 700px) { .tile--wide { grid-column: span 1; height: 300px; } }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(25,27,31,.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px;
    cursor: zoom-out;
  }
  .lightbox[hidden] { display: none; }
  .lightbox img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .lightbox__chiudi { position: absolute; top: 32px; right: 32px; font-size: 13px; color: rgba(255,255,255,.72); }
</style>

<script>
  const lightbox = document.querySelector('.lightbox');
  const img = lightbox?.querySelector('img');

  document.querySelectorAll('.tile').forEach((tile) => {
    tile.addEventListener('click', () => {
      if (!lightbox || !img) return;
      img.src = tile.dataset.src;
      img.alt = tile.dataset.alt ?? '';
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });

  const chiudi = () => {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = '';
  };

  lightbox?.addEventListener('click', chiudi);
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape') chiudi(); });
</script>
