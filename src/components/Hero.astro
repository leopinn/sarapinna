---
import { linguaDa, testi } from '../i18n/index.js';

const lingua = linguaDa(Astro.url.pathname);
const t = testi[lingua];
---

<section class="hero">
  <video class="hero__video" src="/media/verona-hero.mp4" autoplay muted loop playsinline preload="auto"></video>
  <div class="hero__scrim"></div>
  <div class="hero__content container">
    <h1 data-reveal-hero>{t.hero.titolo}</h1>
    <p class="hero__testo" data-reveal-hero>{t.hero.testo}</p>
    <div class="hero__azioni" data-reveal-hero>
      <a class="btn btn--ghost" href={t.nav[1].href}>{t.hero.conoscimi}</a>
      <a class="btn" href={t.nav[2].href}>{t.hero.prenota}</a>
    </div>
    <div class="hero__cue"><span></span> {t.hero.scorri}</div>
  </div>
</section>

<style>
  .hero { position: relative; height: 100vh; min-height: 620px; background: var(--ink); overflow: hidden; }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-pan 28s ease-in-out infinite alternate;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(25,27,31,.62) 0%, rgba(25,27,31,.35) 42%, rgba(25,27,31,.82) 100%);
  }
  .hero__content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: 96px;
    padding-bottom: 96px;
  }
  .hero__eyebrow { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  /* dimensione, tracking e uppercase arrivano da global.css (scala League Gothic) */
  .hero h1 { color: #fff; max-width: 10em; }
  .hero__testo { color: rgba(255,255,255,.7); margin-top: 24px; max-width: 34em; }
  .hero__azioni { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 36px; }
  .hero__cue {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    letter-spacing: .06em;
    color: rgba(255,255,255,.72);
  }
  .hero__cue span {
    width: 1px;
    height: 28px;
    background: rgba(255,255,255,.28);
    animation: scroll-cue 2.6s ease-in-out infinite;
  }

  @media (max-width: 900px) {
    .hero h1 { max-width: 9em; }
  }
</style>
