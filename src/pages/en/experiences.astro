---
import Base from '../../layouts/Base.astro';
import EsperienzeElenco from '../../components/EsperienzeElenco.astro';
import Contatti from '../../components/Contatti.astro';
import { linguaDa, testi } from '../../i18n/index.js';

const lingua = linguaDa(Astro.url.pathname);
const p = testi[lingua].pagine.esperienze;
const e = testi[lingua].esperienze;
---

<Base titolo={p.titolo} descrizione={p.descrizione}>
  <div class="testata">
    <div class="container">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1>{p.h1}</h1>
      <p class="testata__intro">{e.intro}</p>
    </div>
  </div>
  <EsperienzeElenco />
  <Contatti />
</Base>

<style>
  .testata { padding: 160px 0 0; }
  .testata h1 { margin-top: 24px; max-width: 18em; }
  .testata__intro { margin-top: 24px; max-width: 34em; line-height: 1.7; padding-bottom: 32px; }
</style>
