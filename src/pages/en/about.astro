---
import Base from '../../layouts/Base.astro';
import About from '../../components/About.astro';
import Contatti from '../../components/Contatti.astro';
import { linguaDa, testi } from '../../i18n/index.js';

const p = testi[linguaDa(Astro.url.pathname)].pagine.about;
---

<!-- la pagina apre con la foto a tutto schermo: nav trasparente come in Home -->
<Base titolo={p.titolo} descrizione={p.descrizione} navTrasparente={true}>
  <About />
  <Contatti />
</Base>
