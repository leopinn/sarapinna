---
import Base from '../../layouts/Base.astro';
import About from '../../components/About.astro';
import Contatti from '../../components/Contatti.astro';
import { linguaDa, testi } from '../../i18n/index.js';

const p = testi[linguaDa(Astro.url.pathname)].pagine.about;
---

<Base titolo={p.titolo} descrizione={p.descrizione}>
  <div class="testata">
    <div class="container">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1>{p.h1}</h1>
    </div>
  </div>
  <About senzaOcchiello={true} />
  <Contatti />
</Base>

<style>
  .testata { padding: 160px 0 0; }
  .testata h1 { margin-top: 24px; max-width: 18em; }
</style>
