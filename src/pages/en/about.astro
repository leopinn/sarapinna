---
import Base from '../../layouts/Base.astro';
import ChiSono from '../../components/ChiSono.astro';
import Servizi from '../../components/Servizi.astro';
import { linguaDa, testi } from '../../i18n/index.js';

const p = testi[linguaDa(Astro.url.pathname)].pagine.chiSono;
---

<Base titolo={p.titolo} descrizione={p.descrizione}>
  <div class="testata">
    <div class="container">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1>{p.h1}</h1>
    </div>
  </div>
  <ChiSono />
  <Servizi />
</Base>

<style>
  .testata { padding: 160px 0 0; }
  .testata h1 { margin-top: 24px; max-width: 18em; }
</style>
