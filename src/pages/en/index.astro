---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Intro from '../../components/Intro.astro';
import Esperienze from '../../components/Esperienze.astro';
import Contatti from '../../components/Contatti.astro';
import { linguaDa, testi } from '../../i18n/index.js';

const p = testi[linguaDa(Astro.url.pathname)].pagine.home;
---

<Base titolo={p.titolo} descrizione={p.descrizione} navTrasparente={true}>
  <Hero />
  <Intro />
  <Esperienze />
  <Contatti />
</Base>
