---
import Base from '../layouts/Base.astro';
import Galleria from '../components/Galleria.astro';
import Contatti from '../components/Contatti.astro';
---

<Base titolo="Galleria — Sara Pinna" descrizione="Le foto degli appartamenti: soggiorno, camere, cucina e dettagli.">
  <div class="testata">
    <div class="container">
      <p class="eyebrow">Galleria</p>
      <h1>Le case, in fotografia</h1>
    </div>
  </div>
  <Galleria />
  <Contatti />
</Base>

<style>
  .testata { padding: 160px 0 0; }
  .testata h1 { margin-top: 24px; max-width: 18em; }
</style>
